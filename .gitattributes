# Normaliza line endings para LF em todos os arquivos de texto
* text=auto eol=lf

# Força LF explicitamente nos arquivos mais críticos
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.xml    text eol=lf
*.java   text eol=lf
*.md     text eol=lf
*.sh     text eol=lf
*.properties text eol=lf

# Binários — sem conversão
*.jar    binary
*.png    binary
*.jpg    binary
*.pdf    binary
