# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Host (e porta opcional) do servidor PostgreSQL.
# Dentro do Docker Compose use o nome do serviço, ex: oficina-mecanica-postgres
INFRA_HOST_POSTGRES=localhost

# Nome do banco de dados que já deve existir no servidor.
# O schema "oficina_mecanica" é criado automaticamente pela aplicação na inicialização.
POSTGRES_DB=oficina_mecanica

POSTGRES_USERNAME=admin
POSTGRES_PASSWORD=changeme

# ── OpenTelemetry (desabilitado por padrão) ───────────────────────────────────
# Para habilitar, altere quarkus.otel.sdk.disabled para false no application.yaml.
INFRA_HOST_OTEL=localhost:4317

# ── Docker Compose ────────────────────────────────────────────────────────────
# Tag da imagem da aplicação usada no docker-compose.
CUSTOMER_VERSION=latest
