# ════════════════════════════════════════════════════════════════════════════════
# ARQUIVO OPCIONAL. Para subir via `docker compose up` você NÃO precisa de .env —
# o docker-compose.yml já traz todos os valores preenchidos. Use este arquivo apenas
# para sobrescrever defaults (ex.: dev mode local, ou trocar portas/senhas):
#     cp .env.example .env
# ════════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Host (e porta opcional) do servidor PostgreSQL.
# Dentro do Docker Compose use o nome do serviço, ex: oficina-mecanica-postgres
INFRA_HOST_POSTGRES=localhost

# Nome do banco de dados que já deve existir no servidor.
# O schema "oficina_mecanica" é criado automaticamente pela aplicação na inicialização.
POSTGRES_DB=oficina

POSTGRES_USERNAME=admin
POSTGRES_PASSWORD=changeme

# ── Usuários iniciais (seed) / JWT ────────────────────────────────────────────
# Usuários criados automaticamente na primeira inicialização para gerar tokens.
# Defina senhas conhecidas aqui; caso fiquem em branco, a aplicação gera uma
# senha aleatória e a imprime no log de startup (procure por "[SEED]").
APP_SEED_ADMIN_USERNAME=admin
APP_SEED_ADMIN_PASSWORD=admin123
APP_SEED_MECHANIC_USERNAME=mecanico
APP_SEED_MECHANIC_PASSWORD=mecanico123

# Validade do token JWT em horas (padrão: 8).
JWT_EXPIRATION_HOURS=8

# ── OpenTelemetry (desabilitado por padrão) ───────────────────────────────────
# Para habilitar, altere quarkus.otel.sdk.disabled para false no application.yaml.
INFRA_HOST_OTEL=localhost:4317

# ── Docker Compose ────────────────────────────────────────────────────────────
# Tag da imagem da aplicação usada no docker-compose.
CUSTOMER_VERSION=latest
